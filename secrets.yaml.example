# Vorlage fuer secrets.yaml (Kopiere diese Datei nach 'secrets.yaml' und fuelle die Werte aus)
# ACHTUNG: secrets.yaml niemals in Git committen!

wifi_ssid: "DEIN_WLAN_NAME"
wifi_password: "DEIN_WLAN_PASSWORT"

# Verschluesselungsschluessel fuer die Home Assistant Native API (32-Byte Base64)
seeed_xiao_esp32c3__encryption_key: "DEIN_ESPHOME_API_ENCRYPTION_KEY"

# Passwort fuer Over-The-Air (OTA) Updates
seeed_xiao_esp32c3__ota_password: "DEIN_OTA_PASSWORT"

# Fallback Access Point Passwort
seeed_xiao_esp32c3__ap_password: "DEIN_FALLBACK_AP_PASSWORT"
